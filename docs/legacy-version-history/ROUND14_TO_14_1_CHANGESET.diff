@@ -0,0 +1,31 @@
+from pathlib import Path
+import re
+
+root = Path(__file__).resolve().parents[1]
+swift_files = sorted((root / 'Sources').rglob('*.swift'))
+texts = {path: path.read_text() for path in swift_files}
+
+# A top-level private type is file-scoped in practice for this project. If a
+# different Swift file mentions its name, the build will fail even though
+# `swiftc -parse` succeeds. Keep this generic so future file splits are covered.
+private_type = re.compile(r'^private\s+(?:struct|class|enum|protocol|actor|typealias)\s+([A-Za-z_][A-Za-z0-9_]*)', re.M)
+violations = []
+for owner, text in texts.items():
+    for name in private_type.findall(text):
+        token = re.compile(rf'\b{re.escape(name)}\b')
+        for other, other_text in texts.items():
+            if other != owner and token.search(other_text):
+                violations.append(f'{name}: private in {owner.relative_to(root)}, referenced by {other.relative_to(root)}')
+
+assert not violations, '\n'.join(violations)
+
+model = texts[root / 'Sources/Hades2/Hades2TrainerModel.swift']
+view = texts[root / 'Sources/Hades2/Hades2TrainerView.swift']
+assert 'ResourceSectionGroup' not in model
+assert 'BoonSectionGroup' not in model
+assert 'private struct ResourceSectionGroup' in view
+assert 'private struct BoonSectionGroup' in view
+assert 'let groups = boonGroups(options)' in view
+assert 'let selectedID = selection.wrappedValue' in view
+
+print('swift_file_boundaries_round14_1_ok')
