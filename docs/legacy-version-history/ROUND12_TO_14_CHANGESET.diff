+from pathlib import Path
+import importlib.util
+import json
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+manifest_module_path = root / 'Backend/core/module_manifest.py'
+spec = importlib.util.spec_from_file_location('mgt_manifest_for_test', manifest_module_path)
+manifest_module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(manifest_module)
+GameModuleManifest = manifest_module.GameModuleManifest
+
+# Load the build tool as code so descriptor generation can be tested against a
+# temporary second game without copying or patching framework core files.
+tool_spec = importlib.util.spec_from_file_location('mgt_game_module_tool', root/'tools/game_module_tool.py')
+tool = importlib.util.module_from_spec(tool_spec)
+tool_spec.loader.exec_module(tool)
+
+project = Path(tempfile.mkdtemp(prefix='mgt-round13-module-'))
+module_dir = project/'Backend/games/other'
+frontend_dir = project/'Sources/Other'
+module_dir.mkdir(parents=True)
+frontend_dir.mkdir(parents=True)
+(frontend_dir/'Other.swift').write_text('''
+import SwiftUI
+struct OtherGameModule: TrainerGameModule {
+    static func makeModel() -> OtherModel { OtherModel() }
+    static func makeView(model: OtherModel) -> some View { Text("Other") }
+}
+final class OtherModel: ObservableObject, TrainerSessionLifecycle {
+    var backendAvailable = true
+    var busy = false
+    var connected = false
+    func connectFromHost() {}
+    func refreshFromHost() {}
+    func disableAllFromHost() {}
+    func openLog() {}
+    func requestExit() {}
+}
+''', encoding='utf-8')
+manifest_path = module_dir/'module.json'
+manifest_path.write_text(json.dumps({
+    'schemaVersion': 1,
+    'id': 'other',
+    'displayName': 'Other Game',
+    'protocolVersion': 23,
+    'backend': {'adapter':'games.other.adapter:OtherAdapter'},
+    'frontend': {'sourceDirectory':'Sources/Other','moduleType':'OtherGameModule'},
+    'buildRequirements': {'lldbPython':False,'debuggerEntitlement':False},
+}), encoding='utf-8')
+manifest = GameModuleManifest.load(manifest_path)
+manifest.validate_project_paths(project)
+
+generated = project/'ActiveGame.generated.swift'
+tool.generate_swift(manifest, generated)
+text = generated.read_text()
+assert 'extension OtherGameModule' in text
+assert 'typealias ActiveGameModule = OtherGameModule' in text
+assert 'id: "other"' in text
+assert 'displayName: "Other Game"' in text
+assert f'expectedHostProtocolVersion: {tool.HOST_PROTOCOL_VERSION}' in text
+assert 'expectedModuleProtocolVersion: 23' in text
+
+# The framework shell itself remains untouched by a new module.
+app = (root/'Sources/App.swift').read_text()
+core = '\n'.join(p.read_text() for p in sorted((root/'Sources/Core').glob('*.swift')))
+server = (root/'Backend/server.py').read_text()
+assert 'OtherGame' not in app + core + server
+assert 'Hades2' not in app + core + server
+
+print('module_contract_round13_ok')
