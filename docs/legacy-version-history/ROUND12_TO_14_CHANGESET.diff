+from pathlib import Path
+import json
+import plistlib
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+manifest = json.loads((root/'Backend/games/hades2/module.json').read_text())
+build = (root/'build.sh').read_text()
+base_plist = plistlib.loads((root/'Info.plist').read_bytes())
+
+assert manifest['frontend']['architectures'] == ['arm64']
+assert manifest['frontend']['minimumMacOS'] == '14.0'
+assert manifest['app']['bundleIdentifier'] == 'com.gao.macgamingtrainer'
+assert manifest['app']['displayName'] == 'Mac Gaming Trainer'
+
+# The generic template no longer bakes Hades' architecture into every game.
+assert 'LSArchitecturePriority' not in base_plist
+assert '-target arm64-apple-macosx14.0' not in build
+assert 'frontend.architectures' in build
+assert 'frontend.minimumMacOS' in build
+assert 'app.bundleIdentifier' in build
+assert 'app.displayName' in build
+assert 'ARCH_BINARIES' in build and 'lipo' in build
+assert 'LSArchitecturePriority' in build
+
+# Build tool surfaces the manifest fields used by build.sh.
+def field(name):
+    return subprocess.check_output(
+        ['python3', str(root/'tools/game_module_tool.py'), 'hades2', 'field', name],
+        text=True,
+    ).strip()
+
+assert field('frontend.architectures') == 'arm64'
+assert field('frontend.minimumMacOS') == '14.0'
+assert field('app.bundleIdentifier') == 'com.gao.macgamingtrainer'
+assert field('app.displayName') == 'Mac Gaming Trainer'
+
+# A second module that omits app identity gets safe independent defaults rather
+# than inheriting Hades' bundle-scoped preferences.
+from importlib.util import spec_from_file_location, module_from_spec
+spec = spec_from_file_location('mgt_manifest_round14', root/'Backend/core/module_manifest.py')
+module = module_from_spec(spec)
+spec.loader.exec_module(module)
+project = Path(tempfile.mkdtemp(prefix='mgt-build-contract-'))
+module_dir = project/'Backend/games/other_game'
+frontend = project/'Sources/Other'
+module_dir.mkdir(parents=True)
+frontend.mkdir(parents=True)
+(frontend/'Other.swift').write_text('struct OtherGameModule {}\n')
+(module_dir/'module.json').write_text(json.dumps({
+    'id':'other_game','displayName':'Other Game','protocolVersion':1,
+    'backend':{'adapter':'games.other_game.adapter:OtherAdapter'},
+    'frontend':{'sourceDirectory':'Sources/Other','moduleType':'OtherGameModule'},
+}), encoding='utf-8')
+parsed = module.GameModuleManifest.load(module_dir/'module.json')
+parsed.validate_project_paths(project)
+assert parsed.app.bundle_identifier == 'com.gao.macgamingtrainer.other-game'
+assert parsed.app.display_name == 'Mac Gaming Trainer - Other Game'
+assert parsed.frontend.architectures == ()
+assert parsed.frontend.minimum_macos is None
+
+print('build_contract_round14_ok')
