+#!/bin/bash
+set -u
+
+SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
+ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
+LOG="$ROOT/build-gui.log"
+BUILD_SCRIPT="$ROOT/build.sh"
+
+show_dialog() {
+    local title="$1"
+    local message="$2"
+    local primary="$3"
+    local secondary="${4:-}"
+    /usr/bin/osascript - "$title" "$message" "$primary" "$secondary" <<'APPLESCRIPT'
+on run argv
+    set dialogTitle to item 1 of argv
+    set dialogMessage to item 2 of argv
+    set primaryButton to item 3 of argv
+    set secondaryButton to item 4 of argv
+    if secondaryButton is "" then
+        display dialog dialogMessage with title dialogTitle buttons {primaryButton} default button primaryButton with icon note
+    else
+        display dialog dialogMessage with title dialogTitle buttons {secondaryButton, primaryButton} default button primaryButton with icon note
+    end if
+    return button returned of result
+end run
+APPLESCRIPT
+}
+
+if [[ ! -f "$BUILD_SCRIPT" ]]; then
+    show_dialog "Build Trainer" "找不到 build.sh。请把 Build Trainer.app 保留在项目根目录。" "关闭" >/dev/null
+    exit 1
+fi
+
+/bin/chmod +x "$BUILD_SCRIPT" 2>/dev/null || true
+: > "$LOG"
+/usr/bin/osascript -e 'display notification "正在编译 Mac Gaming Trainer；完成后会弹出结果。" with title "Build Trainer"' >/dev/null 2>&1 || true
+
+cd "$ROOT" || exit 1
+/bin/bash "$BUILD_SCRIPT" >"$LOG" 2>&1
+STATUS=$?
+
+if [[ $STATUS -eq 0 ]]; then
+    APP_PATH="$(/usr/bin/awk '/^Built:$/ { if (getline > 0) { sub(/^  /, ""); print; exit } }' "$LOG" 2>/dev/null || true)"
+    if [[ -z "$APP_PATH" || ! -d "$APP_PATH" ]]; then
+        APP_PATH="$(/usr/bin/find "$ROOT/dist" -maxdepth 1 -type d -name '*.app' -print -quit 2>/dev/null || true)"
+    fi
+    if [[ -n "$APP_PATH" ]]; then
+        CHOICE="$(show_dialog "编译完成" "编译与签名验证已完成。\n\n输出：${APP_PATH#$ROOT/}" "打开 App" "关闭")"
+        if [[ "$CHOICE" == "打开 App" ]]; then
+            /usr/bin/open "$APP_PATH"
+        fi
+    else
+        show_dialog "编译完成" "编译已完成。输出位于 dist 目录。" "关闭" >/dev/null
+    fi
+    exit 0
+fi
+
+TAIL="$(/usr/bin/tail -n 18 "$LOG" 2>/dev/null || true)"
+CHOICE="$(show_dialog "编译失败" "编译失败（退出码 $STATUS）。\n\n最后输出：\n$TAIL" "打开日志" "关闭")"
+if [[ "$CHOICE" == "打开日志" ]]; then
+    /usr/bin/open -a TextEdit "$LOG"
+fi
+exit "$STATUS"
