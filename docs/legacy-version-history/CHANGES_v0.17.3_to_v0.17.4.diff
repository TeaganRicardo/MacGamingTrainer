diff -ruN '--exclude=VALIDATION_v0.17.4.txt' '--exclude=CHANGES_v0.17.3_to_v0.17.4.diff' /mnt/data/MacGamingTrainer_v0.17.3_work/MacGamingTrainer_v0.17.3/tests/test_hades2_visual_baseline_v0174.py /mnt/data/MacGamingTrainer_v0.17.4/tests/test_hades2_visual_baseline_v0174.py
--- /mnt/data/MacGamingTrainer_v0.17.3_work/MacGamingTrainer_v0.17.3/tests/test_hades2_visual_baseline_v0174.py	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/MacGamingTrainer_v0.17.4/tests/test_hades2_visual_baseline_v0174.py	2026-09-17 14:21:36.413963006 +0000
@@ -0,0 +1,58 @@
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+HADES = ROOT / 'Sources/Hades2'
+all_hades = '\n'.join(p.read_text() for p in HADES.rglob('*.swift'))
+view = (HADES / 'Hades2View.swift').read_text()
+features = (HADES / 'Views/Controls/Hades2FeatureControls.swift').read_text()
+stats = (HADES / 'Views/Controls/Hades2StatControls.swift').read_text()
+resource = (HADES / 'Views/Controls/Hades2ResourceEditor.swift').read_text()
+management = (HADES / 'Views/Hades2ManagementViews.swift').read_text()
+theme = (ROOT / 'Sources/Core/UI/TrainerTheme.swift').read_text()
+
+# Hades owns its proven v0.11 visual controls. Core primitives must not silently
+# restyle the game module during host/framework refactors.
+for primitive in (
+    'TrainerRow(', 'TrainerToggleControl(', 'TrainerMetricCard(',
+    'TrainerLockButton(', 'TrainerConnectionCard(', 'TrainerSectionHeading(',
+    'TrainerMessageBanner(', 'TrainerNumberField(', 'TrainerShortcutBadge(',
+    'TrainerIconLabel(',
+):
+    assert primitive not in all_hades, f'Core visual primitive leaked into Hades UI: {primitive}'
+
+# v0.11 palette and main feature-control geometry.
+assert 'accent: Color(red: 0.64, green: 0.51, blue: 1.0)' in theme
+assert 'deferred: Color(red: 0.43, green: 0.56, blue: 0.48)' in theme
+for source in (features,):
+    assert '.frame(width: 44, height: 25)' in source
+    assert 'Circle().fill(.white).frame(width: 19, height: 19).padding(3)' in source
+    assert '.frame(width: 40, height: 40)' in source
+    assert '.padding(.horizontal, 22)' in source
+    assert '.background(theme.panel)' in source
+
+# Compact resource multipliers keep the native small switch used by v0.11;
+# the main feature list keeps the old custom capsule switch.
+assert '.toggleStyle(.switch)' in features
+assert '.controlSize(.small)' in features
+assert 'Capsule()' in features
+
+# Stat/resource/metric controls preserve the old row/card geometry.
+assert '.frame(width: 90)' in stats
+assert '.frame(minHeight: 62)' in stats
+assert '.background(theme.panel)' in stats
+assert 'Color.white.opacity(locked ? 0.08 : 0.035)' in stats
+assert 'TextField("数量", text: $amount)' in resource
+assert 'Label(locked ? "已锁定" : "锁定"' in resource
+
+# Main view uses the old direct connection/status card and metric rendering.
+assert 'Circle().fill(model.connected ? Color.green : Color.gray)' in view
+assert '.background(panel, in: RoundedRectangle(cornerRadius: 14))' in view
+assert 'Color.white.opacity(locked ? 0.08 : 0.035)' in view
+assert 'Label(title, systemImage: icon).font(.title3.weight(.semibold))' in view
+
+# Management sheets also use the old subtle fills instead of the newer raised
+# generic cards.
+assert 'Color.white.opacity(0.04)' in management
+assert 'Color.white.opacity(0.035)' in management
+
+print('hades2_visual_baseline_v0174_ok')
