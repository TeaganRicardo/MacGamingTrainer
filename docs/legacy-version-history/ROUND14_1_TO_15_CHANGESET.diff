--- /mnt/data/mgt_r15_baseline/MacGamingTrainer_v14_1_round14_1/Sources/Core/Runtime/TrainerBackendSession.swift	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/mgt_r15_work/MacGamingTrainer_v14_1_round14_1/Sources/Core/Runtime/TrainerBackendSession.swift	2026-09-17 10:58:52.523766352 +0000
@@ -0,0 +1,157 @@
+import Foundation
+import Combine
+
+/// UI-facing, game-agnostic backend session state.
+///
+/// `BackendClient` owns request ordering and JSONL framing. This layer owns the
+/// common trainer-host lifecycle around that client: locating/starting the
+/// backend, protocol compatibility, busy/error/notice presentation state, and
+/// termination cleanup. A game model only supplies how to decode its own
+/// result/state payload.
+final class TrainerBackendSession: ObservableObject {
+    @Published private(set) var backendAvailable = false
+    @Published private(set) var backendProtocolVersion: Int?
+    @Published private(set) var backendModuleProtocolVersion: Int?
+    @Published private(set) var protocolCompatible = true
+    @Published private(set) var busy = false
+    @Published private(set) var operation = ""
+    @Published var error = ""
+    @Published var notice = ""
+
+    private let client = BackendClient()
+    private var suppressTerminationError = false
+    private var applyPayload: (([String: Any]) -> Void)?
+    private var resetGameState: (() -> Void)?
+    private var log: ((String) -> Void)?
+
+    var isRunning: Bool { client.isRunning }
+    var isStarted: Bool { client.isStarted }
+
+    func start(
+        descriptor: GameModuleDescriptor,
+        backendScriptURL: URL? = nil,
+        applyPayload: @escaping ([String: Any]) -> Void,
+        resetGameState: @escaping () -> Void,
+        log: @escaping (String) -> Void
+    ) throws {
+        guard !client.isStarted else { return }
+        let scriptURL: URL
+        if let backendScriptURL {
+            scriptURL = backendScriptURL
+        } else {
+            guard let resourceURL = Bundle.main.resourceURL else {
+                throw NSError(domain: "TrainerBackendSession", code: 1, userInfo: [NSLocalizedDescriptionKey: "找不到 App Resources 目录。请使用 build.sh 重新构建完整 App。"])
+            }
+            scriptURL = resourceURL.appendingPathComponent("Backend/core/server.py")
+        }
+        guard FileManager.default.fileExists(atPath: scriptURL.path) else {
+            throw NSError(domain: "TrainerBackendSession", code: 2, userInfo: [NSLocalizedDescriptionKey: "找不到后端：\(scriptURL.path)。请使用 build.sh 重新构建完整 App。"])
+        }
+        self.applyPayload = applyPayload
+        self.resetGameState = resetGameState
+        self.log = log
+        suppressTerminationError = false
+        backendAvailable = false
+        backendProtocolVersion = nil
+        backendModuleProtocolVersion = nil
+        protocolCompatible = true
+        busy = false
+        operation = ""
+        error = ""
+        notice = ""
+
+        try client.start(
+            scriptURL: scriptURL,
+            expectation: BackendProtocolExpectation(
+                gameID: descriptor.backendGameID,
+                hostProtocolVersion: descriptor.expectedHostProtocolVersion,
+                moduleProtocolVersion: descriptor.expectedModuleProtocolVersion
+            ),
+            onRequestStarted: { [weak self] title, announceSuccess in
+                guard let self = self else { return }
+                self.busy = true
+                self.operation = title
+                self.error = ""
+                if announceSuccess { self.notice = "" }
+            },
+            onReply: { [weak self] reply in
+                guard let self = self else { return }
+                self.backendProtocolVersion = reply.hostProtocolVersion
+                self.backendModuleProtocolVersion = reply.moduleProtocolVersion
+                self.protocolCompatible = true
+                self.busy = false
+                if reply.success {
+                    if let result = reply.result { self.applyPayload?(result) }
+                    if reply.announceSuccess { self.notice = "\(reply.operation)完成" }
+                } else {
+                    if let state = reply.state { self.applyPayload?(state) }
+                    self.error = reply.errorMessage ?? "操作失败，请查看日志。"
+                    self.log?("\(reply.operation)失败 [\(reply.errorCode ?? "unknown")]：\(self.error)")
+                }
+            },
+            onProtocolMismatch: { [weak self] message in
+                guard let self = self else { return }
+                self.protocolCompatible = false
+                self.backendAvailable = false
+                self.busy = false
+                self.error = message + " 请使用同一发布包中的 build.sh 重新构建 App。"
+                self.log?("协议不兼容：\(message)")
+            },
+            onStderr: { [weak self] clean in
+                self?.log?("BACKEND: \(clean)")
+            },
+            onLog: { [weak self] line in self?.log?(line) },
+            onTermination: { [weak self] status, stderrTail in
+                self?.handleTermination(status: status, stderrTail: stderrTail)
+            },
+            onClientError: { [weak self] message in
+                self?.busy = false
+                self?.error = message
+            }
+        )
+        backendAvailable = true
+    }
+
+    func send(
+        _ command: String,
+        params: [String: Any] = [:],
+        operation: String,
+        coalesceKey: String? = nil,
+        announceSuccess: Bool = true,
+        completion: ((Bool) -> Void)? = nil
+    ) {
+        client.send(
+            command,
+            params: params,
+            operation: operation,
+            coalesceKey: coalesceKey,
+            announceSuccess: announceSuccess,
+            completion: completion
+        )
+    }
+
+    func stop(suppressTerminationError: Bool = true) {
+        self.suppressTerminationError = suppressTerminationError
+        client.stop()
+    }
+
+    func markUnavailable(_ message: String) {
+        backendAvailable = false
+        busy = false
+        error = message
+    }
+
+    private func handleTermination(status: Int32, stderrTail: String) {
+        let mismatch = !protocolCompatible
+        backendAvailable = false
+        backendProtocolVersion = nil
+        backendModuleProtocolVersion = nil
+        if !mismatch { protocolCompatible = true }
+        busy = false
+        resetGameState?()
+
+        guard !suppressTerminationError && !mismatch else { return }
+        let suffix = stderrTail.isEmpty ? "" : "\n\n后端输出：\n\(stderrTail)"
+        error = "后端已退出（状态 \(status)）。游戏内修改可能仍然生效，请点击重启后端，再连接清理或重启游戏。\(suffix)"
+    }
+}
