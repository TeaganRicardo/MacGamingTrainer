+from pathlib import Path
+import json
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+BACKEND = ROOT / 'Backend'
+if str(BACKEND) not in sys.path:
+    sys.path.insert(0, str(BACKEND))
+
+from core.module_manifest import GameModuleManifest, ManifestError
+from core.protocol import HOST_PROTOCOL_VERSION
+
+
+def manifest_path(game_id: str) -> Path:
+    return ROOT / 'Backend' / 'games' / game_id / 'module.json'
+
+
+def load_manifest(game_id: str) -> GameModuleManifest:
+    manifest = GameModuleManifest.load(manifest_path(game_id))
+    manifest.validate_project_paths(ROOT)
+    return manifest
+
+
+def normalized_manifest(manifest: GameModuleManifest) -> dict:
+    return {
+        **manifest.public_metadata(),
+        'hostProtocolVersion': HOST_PROTOCOL_VERSION,
+        'backend': {'adapter': manifest.adapter},
+        'frontend': None if manifest.frontend is None else {
+            'sourceDirectory': manifest.frontend.source_directory,
+            'moduleType': manifest.frontend.module_type,
+            'architectures': list(manifest.frontend.architectures),
+            'minimumMacOS': manifest.frontend.minimum_macos,
+        },
+        'app': {
+            'bundleIdentifier': manifest.app.bundle_identifier,
+            'displayName': manifest.app.display_name,
+        },
+        'ui': {
+            'sidebarIconSystemName': manifest.presentation.sidebar_icon_system_name,
+            'platformLabel': manifest.presentation.platform_label,
+            'headerTitle': manifest.presentation.header_title,
+        },
+        'buildRequirements': {
+            'lldbPython': manifest.build.lldb_python,
+            'debuggerEntitlement': manifest.build.debugger_entitlement,
+            'entitlements': manifest.build.entitlements,
+        },
+    }
+
+
+def swift_string(value: str) -> str:
+    return json.dumps(value, ensure_ascii=False)
