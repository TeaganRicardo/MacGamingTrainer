+import SwiftUI
+
+struct TrainerPickerSection<Item: Identifiable>: Identifiable {
+    let id: Int
+    let title: String
+    let items: [Item]
+}
+
+struct TrainerResourceEditor<Item: Identifiable>: View where Item.ID == String {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    @Binding var search: String
+    @Binding var selection: String
+    @Binding var amount: String
+    let sections: [TrainerPickerSection<Item>]
+    let enabled: Bool
+    let locked: Bool
+    let itemLabel: (Item) -> String
+    let onLock: () -> Void
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 18) {
+            HStack {
+                Label(title, systemImage: icon)
+                    .font(.subheadline.weight(.medium))
+                    .foregroundStyle(theme.accent)
+                Spacer()
+                TextField("搜索名称或资源 ID", text: $search)
+                    .textFieldStyle(.roundedBorder)
+                    .frame(maxWidth: 260)
+            }
+            Picker(title, selection: $selection) {
+                if selection.isEmpty || sections.allSatisfy({ $0.items.isEmpty }) {
+                    Text("没有匹配项目").tag("")
+                }
+                ForEach(sections) { section in
+                    Section(header: Text(section.title)) {
+                        ForEach(section.items) { item in
+                            Text(itemLabel(item)).tag(item.id)
+                        }
+                    }
+                }
+            }
+            .labelsHidden()
+            .frame(maxWidth: .infinity)
+            .disabled(!enabled || sections.allSatisfy({ $0.items.isEmpty }))
+
+            HStack(spacing: 12) {
+                Spacer()
+                TextField("数量", text: $amount)
+                    .textFieldStyle(.roundedBorder)
+                    .frame(width: 100)
+                    .disabled(!enabled || selection.isEmpty)
+                TrainerLockButton(locked: locked, enabled: enabled && !selection.isEmpty, action: onLock)
+            }
+        }
+    }
+}
