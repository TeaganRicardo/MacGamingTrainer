+        nextRoomReward = reward
+        send("set_next_room_reward_desired", params: ["reward": reward ?? NSNull()], title: reward == nil ? "清除下一房奖励" : "设置下一房奖励")
+    }
+
+    private func shortcutPayload() -> [String: Int] {
+        Dictionary(uniqueKeysWithValues: ShortcutAction.uiOrder.map { ($0.rawValue, shortcutDigit($0)) })
+    }
+
+    func saveProfile(_ name: String) {
+        let trimmed = name.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { return }
+        send("save_profile", params: ["name": trimmed, "shortcuts": shortcutPayload()], title: "保存自定义配置")
+    }
+
+    func loadProfile(_ name: String) {
+        guard !name.isEmpty else { return }
+        send("load_profile", params: ["name": name], title: "载入自定义配置")
+    }
+
+    func deleteProfile(_ name: String) {
+        guard !name.isEmpty else { return }
+        send("delete_profile", params: ["name": name], title: "删除自定义配置")
+    }
+
+    func listProfiles() { send("list_profiles", title: "读取自定义配置") }
+    func runDiagnostics() { send("diagnostics", title: "运行自检") }
+    func exportDiagnostics() { send("export_diagnostics", title: "导出诊断包") }
+    func cancelStagedRestore() { send("cancel_staged_restore", title: "取消暂存恢复") }
+
+    func spawnBoon(_ loot: String) {
+        guard canSpawnReward, boons.contains(where: { $0.id == loot }) else { return }
+        send("spawn_reward", params: ["reward": loot], title: "生成掉落物")
+    }
+
+    func setMultiplier(_ key: String, text: String) {
+        guard canEditDesired, let value = Double(text), value.isFinite, (1...100).contains(value) else { return }
+        let current: Double
+        switch key {
+        case "damageMultiplier": current = damageMultiplier
+        case "moneyMultiplier": current = moneyMultiplier
+        case "resourceMultiplier": current = resourceMultiplier
+        default: return
+        }
+        if abs(current - value) < 0.0001 { return }
+        switch key {
+        case "damageMultiplier": damageMultiplier = value
+        case "moneyMultiplier": moneyMultiplier = value
+        case "resourceMultiplier": resourceMultiplier = value
+        default: break
+        }
+        enqueueMutation(key: "feature.\(key)", command: "set_desired", params: ["feature": key, "value": value], title: "更新倍率")
+    }
+
+    func setCounter(_ counter: String, text: String) {
+        guard canSetVitals, let value = Double(text), value.isFinite, (0...999_999).contains(value) else { return }
+        if counter == "spellCharge", let current = spellCharge, abs(current - value) < 0.0001 { return }
+        enqueueMutation(key: "counter.\(counter)", command: "set_counter",
+            params: ["counter": counter, "value": value], title: "更新局内计数")
+    }
