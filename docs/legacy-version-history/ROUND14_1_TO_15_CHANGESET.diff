+    private func apply(_ result: [String: Any]) {
+        let wasConnected = connected
+        let desiredBeforeApply = Dictionary(uniqueKeysWithValues: desiredFeatureKeys.map { ($0, desiredFeatureEnabled($0)) })
+        if let value = result["connected"] as? Bool { connected = value }
+        if result.keys.contains("pid") { pid = result["pid"] as? Int }
+        if let value = result["version"] as? String { version = value }
+        if let value = result["status"] as? String { status = value }
+        if let value = result["scene"] as? String { scene = value }
+        if let values = result["capabilities"] as? [String: Any] {
+            capabilities = values.reduce(into: [:]) { partial, entry in
+                if let value = entry.value as? Bool { partial[entry.key] = value }
+            }
+        }
+        if let values = result["activeFeatures"] as? [String: Any] {
+            activeFeatures = values.reduce(into: [:]) { partial, entry in
+                if let value = entry.value as? Bool { partial[entry.key] = value }
+            }
+        }
+        if let values = result["dormantFeatures"] as? [String: Any] {
+            dormantFeatures = values.reduce(into: [:]) { partial, entry in
+                if let value = entry.value as? Bool { partial[entry.key] = value }
+            }
+        }
+        if let values = result["featureSupport"] as? [String: Any] {
+            featureSupport = values.reduce(into: [:]) { partial, entry in
+                if let value = entry.value as? Bool { partial[entry.key] = value }
+            }
+        }
+        if let values = result["featureErrors"] as? [String: Any] {
+            let issues = values.compactMap { key, value -> String? in
+                guard let message = value as? String, !message.isEmpty else { return nil }
+                return "\(key): \(message)"
+            }.sorted()
+            runtimeIssue = issues.isEmpty ? "" : "运行时未激活：" + issues.joined(separator: "；")
+        } else {
+            runtimeIssue = ""
+        }
+        if let value = result["godMode"] as? Bool { godMode = value }
+        if let value = result["infiniteHealth"] as? Bool { infiniteHealth = value }
+        if let value = result["infiniteMana"] as? Bool { infiniteMana = value }
+        if let value = result["instantCastCooldown"] as? Bool { instantCastCooldown = value }
+        if let value = result["hexAlwaysReady"] as? Bool { hexAlwaysReady = value }
+        if let value = result["infiniteAmmo"] as? Bool { infiniteAmmo = value }
+        if let value = result["autoMiniGames"] as? Bool { autoMiniGames = value }
+        if let value = result["gardenQoL"] as? Bool { gardenQoL = value }
+        if let value = result["boonRarityEnabled"] as? Bool { boonRarityEnabled = value }
+        if let value = result["boonChoiceEnabled"] as? Bool { boonChoiceEnabled = value }
+        if let value = result["boonChoiceCount"] as? Int { boonChoiceCount = value }
+        if let value = result["damageEnabled"] as? Bool { damageEnabled = value }
+        if let value = result["gameSpeed"] as? Double { gameSpeed = value }
+        if let value = result["damageMultiplier"] as? Double { damageMultiplier = value }
+        if let values = result["warnings"] as? [String] { warning = values.joined(separator: "\n") }
+        else if let value = result["warning"] as? String { warning = value }
+        if let value = result["moneyLocked"] as? Bool { moneyLocked = value }
+        if let value = result["moneyMultiplier"] as? Double { moneyMultiplier = value }
+        if let value = result["moneyMultiplierEnabled"] as? Bool { moneyMultiplierEnabled = value }
+        if let value = result["resourceMultiplier"] as? Double { resourceMultiplier = value }
+        if let value = result["resourceMultiplierEnabled"] as? Bool { resourceMultiplierEnabled = value }
+        if let rarity = result["boonRarity"] as? [String: Any] {
+            if let value = rarity["target"] as? String { boonRarityTarget = value }
+            if let value = rarity["multiplier"] as? Double { boonRarityMultiplier = value }
+            if let value = rarity["allowLegendary"] as? Bool { boonAllowLegendary = value }
+            if let value = rarity["allowDuo"] as? Bool { boonAllowDuo = value }
+        }
+        if result.keys.contains("nextRoomReward") { nextRoomReward = result["nextRoomReward"] as? String }
+        if result.keys.contains("rerolls") { rerolls = result["rerolls"] as? Double }
+        if let value = result["rerollsLocked"] as? Bool { rerollsLocked = value }
+        let rewardValues = (result["rewards"] as? [[String: Any]]) ?? (result["boons"] as? [[String: Any]])
+        if let values = rewardValues {
+            boons = values.compactMap {
+                guard let id = $0["id"] as? String, let name = $0["name"] as? String else { return nil }
+                return BoonOption(id: id, name: name, englishName: $0["englishName"] as? String ?? "",
+                    category: $0["category"] as? String ?? "神祇祝福",
+                    kind: $0["kind"] as? String ?? "loot", group: $0["group"] as? String ?? "pickup",
+                    sectionTitle: $0["sectionTitle"] as? String ?? "")
+            }
+        }
+        if let values = result["statSupport"] as? [String: Any] {
+            statSupport = values.reduce(into: [:]) { partial, entry in
+                if let value = entry.value as? Bool { partial[entry.key] = value }
+            }
+        }
+        if let values = result["statAvailable"] as? [String: Any] {
+            statAvailable = values.reduce(into: [:]) { partial, entry in
+                if let value = entry.value as? Bool { partial[entry.key] = value }
+            }
+        }
+        if let stats = result["stats"] as? [String: Any] {
+            func decodeStat(_ key: String) -> (Double?, Bool) {
+                guard let item = stats[key] as? [String: Any] else { return (nil, false) }
+                return (item["value"] as? Double, item["locked"] as? Bool ?? false)
+            }
+            let grasp = decodeStat("grasp"), dodge = decodeStat("dodge"), crit = decodeStat("crit"), charge = decodeStat("chargeSpeed")
+            let move = decodeStat("moveSpeed"), sprint = decodeStat("sprintSpeed"), dash = decodeStat("dashSpeed")
+            let attack = decodeStat("attackSpeed"), manaRegen = decodeStat("manaRegen"), enemyDamage = decodeStat("enemyDamage"), enemyHealth = decodeStat("enemyHealth")
+            graspValue = grasp.0; graspLocked = grasp.1
+            dodgeValue = dodge.0; dodgeLocked = dodge.1
+            critValue = crit.0; critLocked = crit.1
+            chargeSpeedValue = charge.0; chargeSpeedLocked = charge.1
+            moveSpeedValue = move.0; moveSpeedLocked = move.1
+            sprintSpeedValue = sprint.0; sprintSpeedLocked = sprint.1
+            dashSpeedValue = dash.0; dashSpeedLocked = dash.1
+            attackSpeedValue = attack.0; attackSpeedLocked = attack.1
+            manaRegenValue = manaRegen.0; manaRegenLocked = manaRegen.1
+            enemyDamageValue = enemyDamage.0; enemyDamageLocked = enemyDamage.1
+            enemyHealthValue = enemyHealth.0; enemyHealthLocked = enemyHealth.1
+        }
+        if let values = result["backups"] as? [[String: Any]] {
+            backups = values.compactMap {
+                guard let id = $0["id"] as? String else { return nil }
+                return SaveBackup(id: id, name: $0["name"] as? String ?? id,
+                    createdAt: $0["createdAt"] as? String ?? id, fileCount: $0["fileCount"] as? Int ?? 0,
+                    runCount: $0["runCount"] as? Int, hotBackup: $0["hotBackup"] as? Bool ?? false,
+                    path: $0["path"] as? String ?? "", valid: $0["valid"] as? Bool ?? false,
+                    error: $0["error"] as? String ?? "")
+            }
+        }
+        if let values = result["profiles"] as? [[String: Any]] {
+            profiles = values.compactMap { item in
+                guard let name = item["name"] as? String else { return nil }
+                return TrainerProfile(name: name, updatedAt: item["updatedAt"] as? String ?? "")
+            }
+        }
+        if let values = result["checks"] as? [[String: Any]] {
+            diagnostics = values.compactMap { item in
+                guard let name = item["name"] as? String else { return nil }
+                return DiagnosticCheck(name: name, ok: item["ok"] as? Bool ?? false, detail: String(describing: item["detail"] ?? ""))
+            }
+            diagnosticsPassed = result["passed"] as? Int ?? diagnostics.filter(\.ok).count
+            diagnosticsTotal = result["total"] as? Int ?? diagnostics.count
+        }
+        // Runtime installation can lag desired-state acknowledgement by a
+        // fraction of a second. Keep the normal accent during that grace
+        // window, but immediately surface a genuine dormant/waiting state.
+        for key in activeFeatures.keys where activeFeatures[key] == true { clearFeatureActivationGrace(key) }
+        // Cover enablements that arrive through profile loading/backend replay,
+        // not just a direct click that went through feature(_:value:).
+        for key in desiredFeatureKeys where desiredFeatureEnabled(key)
+            && desiredBeforeApply[key] != true && activeFeatures[key] != true && dormantFeatures[key] != true {
+            beginFeatureActivationGrace(key)
+        }
+        // Reconnection can replay an already-enabled desired state without a
+        // local false->true transition. Only grace features that are not already
+        // classified as genuinely dormant/waiting for an environment.
+        if !wasConnected && connected {
+            for key in desiredFeatureKeys where desiredFeatureEnabled(key)
+                && activeFeatures[key] != true && dormantFeatures[key] != true {
+                beginFeatureActivationGrace(key)
+            }
+        }
+
+        if result.keys.contains("pendingRestore") {
+            let pending = result["pendingRestore"] as? [String: Any]
+            pendingRestoreID = pending?["backupId"] as? String
+            updatePendingRestorePolling()
+        }
+        if let shortcuts = result["shortcuts"] as? [String: Any] { applyProfileShortcuts(shortcuts) }
+        if result.keys.contains("health") { health = result["health"] as? Double }
+        if result.keys.contains("maxHealth") { maxHealth = result["maxHealth"] as? Double }
+        if let value = result["healthLocked"] as? Bool { healthLocked = value }
+        if result.keys.contains("mana") { mana = result["mana"] as? Double }
+        if result.keys.contains("maxMana") { maxMana = result["maxMana"] as? Double }
+        if let value = result["manaLocked"] as? Bool { manaLocked = value }
+        if result.keys.contains("armor") { armor = result["armor"] as? Double }
+        if let value = result["armorLocked"] as? Bool { armorLocked = value }
+        if result.keys.contains("spellCharge") { spellCharge = result["spellCharge"] as? Double }
+        if result.keys.contains("spellChargeCost") { spellChargeCost = result["spellChargeCost"] as? Double }
+        if result.keys.contains("money") { money = result["money"] as? Double }
+        if result.keys.contains("runCount") { runCount = result["runCount"] as? Int }
+        if let values = result["elements"] as? [[String: Any]] {
+            elements = values.compactMap { item in
+                guard let id = item["id"] as? String, let name = item["name"] as? String else { return nil }
+                return ElementCount(id: id, name: name, count: item["count"] as? Double ?? 0, locked: item["locked"] as? Bool ?? false)
+            }
+        }
+        if let values = result["resources"] as? [[String: Any]] {
+            resources = values.compactMap {
+                guard let id = $0["id"] as? String, let name = $0["name"] as? String else { return nil }
+                return MaterialResource(id: id, name: name, englishName: $0["englishName"] as? String ?? "",
+                    count: $0["count"] as? Double ?? 0, locked: $0["locked"] as? Bool ?? false,
+                    sectionTitle: $0["sectionTitle"] as? String ?? "资源")
+            }
+        }
+        if let issue = result["error"] as? String, !issue.isEmpty { error = issue }
+    }
