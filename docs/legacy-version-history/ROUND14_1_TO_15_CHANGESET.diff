+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+
+# 1) Physical boundaries are domain-oriented and stable.
+expected = [
+    'Sources/Core/Runtime/BackendProcess.swift',
+    'Sources/Core/Runtime/BackendClient.swift',
+    'Sources/Core/Runtime/TrainerBackendSession.swift',
+    'Sources/Core/Game/GameModule.swift',
+    'Sources/Core/Game/GameDescriptor.swift',
+    'Sources/Core/Game/FeatureState.swift',
+    'Sources/Core/UI/TrainerTheme.swift',
+    'Sources/Core/UI/TrainerShell.swift',
+    'Sources/Core/UI/TrainerSidebar.swift',
+    'Sources/Core/UI/FeatureToggleRow.swift',
+    'Sources/Core/UI/MultiplierRow.swift',
+    'Sources/Core/UI/StatEditorRow.swift',
+    'Sources/Core/UI/ResourceEditor.swift',
+    'Sources/Core/UI/StatusComponents.swift',
+    'Sources/Core/Input/GlobalHotkeys.swift',
+    'Backend/core/adapter.py',
+    'Backend/core/protocol.py',
+    'Backend/core/registry.py',
+    'Backend/core/server.py',
+    'Tools/generate_game_binding.py',
+    'Tools/validate_game_module.py',
+]
+for rel in expected:
+    assert (root/rel).is_file(), rel
+
+# Old Hades-era flat host files must stay gone.
+for rel in (
+    'Backend/server.py',
+    'Backend/games/registry.py',
+    'Sources/Core/BackendClient.swift',
+    'Sources/Core/BackendProcess.swift',
+    'Sources/Core/GameModule.swift',
+    'Sources/Core/GlobalHotkeys.swift',
+    'Sources/Core/TrainerBackendSession.swift',
+):
+    assert not (root/rel).exists(), rel
+
+# 2) Core/App/build contain no game or distribution-specific implementation.
+core_swift = '\n'.join(p.read_text() for p in sorted((root/'Sources/Core').rglob('*.swift')))
+core_py = '\n'.join(p.read_text() for p in sorted((root/'Backend/core').glob('*.py')))
+app = (root/'Sources/App.swift').read_text()
+build = (root/'build.sh').read_text()
+for token in ('Hades2', 'Hades II', 'Supergiant', '1145350', 'WeaponCast', 'CurrentRun'):
+    assert token not in core_swift + core_py + app + build, token
+for token in ('SteamSpec', 'steam://', 'steamAppId'):
+    assert token not in core_py, token
+assert 'Backend/core/server.py' in core_swift
+assert 'Backend/core/server.py' not in (root/'Sources/Hades2/Hades2Model.swift').read_text()
+assert 'Backend/games/hades2' not in build
+assert 'Sources/Hades2' not in build
+
+# 3) Theme/chrome lives in Core/UI. Hades contains no base RGB/style literals.
+theme = (root/'Sources/Core/UI/TrainerTheme.swift').read_text()
+for token in ('background:', 'accent:', 'panel:', 'panelRaised:', 'warning:', 'success:', 'panelCornerRadius:', 'controlCornerRadius:'):
+    assert token in theme, token
+hades_ui = '\n'.join(p.read_text() for p in sorted((root/'Sources/Hades2').rglob('*.swift')))
+for pattern in (
+    r'Color\(red:', r'Color\.white\.opacity', r'Color\.cyan',
+    r'RoundedRectangle\(cornerRadius:\s*[0-9]',
+):
+    assert re.search(pattern, hades_ui) is None, pattern
+for shared in (
+    'TrainerShell', 'TrainerSidebar', 'TrainerFeatureToggleRow',
+    'TrainerFeatureMultiplierRow', 'TrainerMultiplierRow', 'TrainerStatEditorRow',
+    'TrainerResourceEditor', 'TrainerConnectionCard', 'TrainerMessageBanner',
+):
+    assert shared in hades_ui, shared
+assert '.trainerTheme(.standard)' in app
+
+# 4) Hades-only distribution/runtime concepts remain inside its module.
+hades_config = (root/'Backend/games/hades2/config.py').read_text()
+assert 'class SteamSpec' in hades_config
+assert 'steam://rungameid/' in hades_config
+assert 'SteamSpec' not in (root/'Backend/core/game_spec.py').read_text()
+assert (root/'Backend/games/hades2/runtime/hades.lua').is_file()
+
+# 5) Tooling/build are manifest-driven rather than game-special-cased.
+assert 'Tools/validate_game_module.py' in build
+assert 'Tools/generate_game_binding.py' in build
+assert 'find "$ROOT/Sources/Core"' in build
+assert 'find "$FRONTEND_DIR"' in build
+assert 'cp -R "$ROOT/Backend/games/$ACTIVE_GAME_ID"' in build
+assert 'Backend/core' in build
+
+# 6) Generated binding + complete selected Swift graph remains parseable.
+generated = Path(tempfile.mkstemp(suffix='.swift')[1])
+try:
+    subprocess.run(['python3', str(root/'Tools/generate_game_binding.py'), 'hades2', str(generated)], check=True)
+    text = generated.read_text()
+    assert 'typealias ActiveGameModule = Hades2GameModule' in text
+    swiftc = __import__('shutil').which('swiftc')
+    if swiftc:
+        sources = [root/'Sources/App.swift'] + sorted((root/'Sources/Core').rglob('*.swift')) + sorted((root/'Sources/Hades2').rglob('*.swift')) + [generated]
+        subprocess.run([swiftc, '-frontend', '-parse', *map(str, sources)], check=True)
+finally:
+    generated.unlink(missing_ok=True)
+
+print('global_decoupling_round15_ok')
