+        connected = false
+        scene = "unknown"
+        capabilities = [:]
+        activeFeatures = [:]
+        dormantFeatures = [:]
+        featureSupport = [:]
+        statAvailable = [:]
+        activationGraceWorkItems.values.forEach { $0.cancel() }
+        activationGraceWorkItems = [:]
+        activationGraceFeatures = []
+        runtimeIssue = ""
+        health = nil
+        maxHealth = nil
+        mana = nil
+        maxMana = nil
+        armor = nil
+        spellCharge = nil
+        spellChargeCost = nil
+        money = nil
+        rerolls = nil
+        resources = []
+        boons = []
+        status = "backend_stopped"
+        mutationWorkItems.values.forEach { $0.cancel() }
+        mutationWorkItems.removeAll()
+    }
