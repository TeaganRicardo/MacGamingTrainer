+        if let runCount = runCount { params["runCount"] = runCount }
+        send("backup", params: params, title: "备份存档") { [weak self] success in
+            if success { self?.send("list_backups", title: "刷新备份列表") }
+        }
+    }
+
+    func renameBackup(_ backupID: String, name: String) {
+        guard backups.contains(where: { $0.id == backupID }), !name.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else { return }
+        send("rename_backup", params: ["backupId": backupID, "name": name], title: "重命名备份")
+    }
