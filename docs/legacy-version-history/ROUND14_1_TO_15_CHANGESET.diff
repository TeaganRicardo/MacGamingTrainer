+import SwiftUI
+
+struct TrainerFeatureToggleRow: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    let state: TrainerFeatureState
+    let shortcutText: String?
+    let action: () -> Void
+
+    private var indicatorColor: Color {
+        if state.isWarning { return theme.warning }
+        if state.isDeferred { return theme.deferred }
+        return state.enabled ? theme.accent : .secondary
+    }
+
+    private var switchFill: Color {
+        if state.isWarning { return theme.warning }
+        if state.isDeferred { return theme.deferred.opacity(0.82) }
+        return state.enabled ? theme.accent : theme.mutedFill
+    }
+
+    var body: some View {
+        HStack(spacing: 16) {
+            Image(systemName: icon)
+                .font(.title3)
+                .foregroundStyle(indicatorColor)
+                .frame(width: 40, height: 40)
+                .background(indicatorColor.opacity(state.enabled ? 0.15 : 0.05), in: RoundedRectangle(cornerRadius: theme.controlCornerRadius))
+            Text(title).font(.subheadline.weight(.semibold))
+            Spacer()
+            Group {
+                if let shortcutText {
+                    Text(shortcutText)
+                        .font(.system(.caption, design: .monospaced))
+                        .foregroundStyle(.secondary)
+                        .padding(7)
+                        .background(theme.subtleFill, in: RoundedRectangle(cornerRadius: theme.compactCornerRadius))
+                } else {
+                    Color.clear.frame(width: 44, height: 25)
+                }
+            }
+            .frame(width: 52)
+            Button(action: action) {
+                Capsule()
+                    .fill(switchFill)
+                    .frame(width: 44, height: 25)
+                    .overlay(alignment: state.enabled ? .trailing : .leading) {
+                        Circle().fill(.white).frame(width: 19, height: 19).padding(3)
+                    }
+            }
+            .buttonStyle(.plain)
+            .disabled(!state.isInteractive)
+            .accessibilityLabel(title)
+            .accessibilityValue(state.enabled ? "开启" : "关闭")
+            .help(state.helpText)
+        }
+        .opacity(state.supported ? 1 : 0.45)
+        .frame(minHeight: 64)
+        .padding(.horizontal, 22)
+        .background(theme.panel)
+    }
+}
