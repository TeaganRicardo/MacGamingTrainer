--- /mnt/data/mgt_r15_baseline/MacGamingTrainer_v14_1_round14_1/Sources/Core/Runtime/BackendProcess.swift	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/mgt_r15_work/MacGamingTrainer_v14_1_round14_1/Sources/Core/Runtime/BackendProcess.swift	2026-09-17 08:55:41.000000000 +0000
@@ -0,0 +1,114 @@
+import Foundation
+
+/// Game-agnostic JSONL worker process. It knows nothing about any specific game or
+/// trainer command schema; game modules own request semantics and state decode.
+final class BackendProcess {
+    private var process: Process?
+    private var input: FileHandle?
+    private var output: FileHandle?
+    private var errorOutput: FileHandle?
+    private let readQueue = DispatchQueue(label: "com.gao.macgamingtrainer.backend-process")
+    private var buffer = Data()
+
+    var isRunning: Bool { process?.isRunning == true }
+    var isStarted: Bool { process != nil }
+
+    func start(
+        scriptURL: URL,
+        gameID: String,
+        onMessage: @escaping ([String: Any]) -> Void,
+        onStderr: @escaping (String) -> Void,
+        onTermination: @escaping (Int32) -> Void
+    ) throws {
+        guard process == nil else { return }
+        readQueue.sync { buffer.removeAll() }
+
+        let task = Process()
+        let stdin = Pipe(), stdout = Pipe(), stderr = Pipe()
+        task.executableURL = URL(fileURLWithPath: "/usr/bin/xcrun")
+        task.arguments = ["python3", "-u", scriptURL.path, "--game", gameID]
+        var environment = ProcessInfo.processInfo.environment
+        environment["PYTHONUNBUFFERED"] = "1"
+        environment["PYTHONDONTWRITEBYTECODE"] = "1"
+        environment["MGT_GAME_ID"] = gameID
+        task.environment = environment
+        task.standardInput = stdin
+        task.standardOutput = stdout
+        task.standardError = stderr
+
+        input = stdin.fileHandleForWriting
+        output = stdout.fileHandleForReading
+        errorOutput = stderr.fileHandleForReading
+
+        stdout.fileHandleForReading.readabilityHandler = { [weak self] handle in
+            let data = handle.availableData
+            guard !data.isEmpty else { return }
+            self?.readQueue.async { [weak self] in
+                self?.consume(data, onMessage: onMessage)
+            }
+        }
+        stderr.fileHandleForReading.readabilityHandler = { handle in
+            let data = handle.availableData
+            guard let message = String(data: data, encoding: .utf8), !message.isEmpty else { return }
+            DispatchQueue.main.async { onStderr(message) }
+        }
+        task.terminationHandler = { [weak self] task in
+            DispatchQueue.main.async {
+                guard let self = self else { return }
+                self.output?.readabilityHandler = nil
+                self.errorOutput?.readabilityHandler = nil
+                self.input = nil
+                self.output = nil
+                self.errorOutput = nil
+                self.process = nil
+                onTermination(task.terminationStatus)
+            }
+        }
+
+        do {
+            try task.run()
+            process = task
+        } catch {
+            stdout.fileHandleForReading.readabilityHandler = nil
+            stderr.fileHandleForReading.readabilityHandler = nil
+            try? stdin.fileHandleForWriting.close()
+            input = nil
+            output = nil
+            errorOutput = nil
+            process = nil
+            throw error
+        }
+    }
+
+    func send(_ object: [String: Any]) throws {
+        guard let input = input, process?.isRunning == true else {
+            throw NSError(domain: "BackendProcess", code: 1, userInfo: [NSLocalizedDescriptionKey: "后端进程未运行。"])
+        }
+        var data = try JSONSerialization.data(withJSONObject: object)
+        data.append(10)
+        try input.write(contentsOf: data)
+    }
+
+    func stop() {
+        try? input?.close()
+        output?.readabilityHandler = nil
+        errorOutput?.readabilityHandler = nil
+        process?.terminate()
+    }
+
+    private func consume(_ data: Data, onMessage: @escaping ([String: Any]) -> Void) {
+        buffer.append(data)
+        while let newline = buffer.firstIndex(of: 10) {
+            let line = buffer.prefix(upTo: newline)
+            buffer.removeSubrange(...newline)
+            guard !line.isEmpty else { continue }
+            do {
+                guard let object = try JSONSerialization.jsonObject(with: line) as? [String: Any] else { continue }
+                DispatchQueue.main.async { onMessage(object) }
+            } catch {
+                // The caller owns diagnostics/log presentation; malformed stdout
+                // is intentionally ignored here so one stray line cannot kill IPC.
+            }
+        }
+    }
+}
