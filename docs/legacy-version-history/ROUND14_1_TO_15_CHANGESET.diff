-    local desired = M.desiredFeatures.moneyMultiplierEnabled or M.desiredFeatures.resourceMultiplierEnabled
-      or next(M.resourceLocks) ~= nil
-    if not desired then
-      releaseEconomyRuntime()
-      M.featureErrors.economy = nil
-      return true
