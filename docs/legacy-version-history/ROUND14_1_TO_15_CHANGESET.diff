+          local attempts = 0
+          while hasDisallowedBoonOption(lootData) and attempts < 4 do
+            attempts = attempts + 1
+            lootData.UpgradeOptions = nil
+            packed = table.pack(original(lootData, args, ...))
+          end
+          if hasDisallowedBoonOption(lootData) and type(lootData.UpgradeOptions) == "table" then
+            local filtered = setmetatable({}, arrayMeta)
+            for _, option in ipairs(lootData.UpgradeOptions) do
+              if optionAllowedByRarityConfig(option) then filtered[#filtered + 1] = option end
+            end
+            lootData.UpgradeOptions = filtered
