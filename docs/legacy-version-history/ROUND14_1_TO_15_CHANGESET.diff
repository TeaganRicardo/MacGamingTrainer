+import SwiftUI
+
+private struct Hades2BoonSection: Identifiable {
+    let id: Int
+    let title: String
+    let items: [BoonOption]
+}
+
+struct Hades2BoonPicker: View {
+    let title: String?
+    let icon: String?
+    let options: [BoonOption]
+    @Binding var selection: String
+    let enabled: Bool
+    let onSpawn: (String) -> Void
+
+    private var groups: [Hades2BoonSection] {
+        var result: [Hades2BoonSection] = []
+        for item in options {
+            let title = item.sectionTitle.isEmpty ? item.category : item.sectionTitle
+            if let last = result.last, last.title == title {
+                result[result.count - 1] = Hades2BoonSection(id: last.id, title: title, items: last.items + [item])
+            } else {
+                result.append(Hades2BoonSection(id: result.count, title: title, items: [item]))
+            }
+        }
+        return result
+    }
+
+    private func displayName(_ option: BoonOption) -> String {
+        option.englishName.isEmpty ? option.name : "\(option.name) · \(option.englishName)"
+    }
+
+    var body: some View {
+        let selectedID = selection
+        let hasSelection = options.contains { $0.id == selectedID }
+        return VStack(alignment: .leading, spacing: title == nil ? 0 : 10) {
+            if let title, let icon {
+                Label(title, systemImage: icon).font(.subheadline.weight(.medium))
+            }
+            HStack(spacing: 12) {
+                Picker(title ?? "特殊祝福", selection: $selection) {
+                    if selectedID.isEmpty || options.isEmpty {
+                        Text("没有可用项目").tag("")
+                    }
+                    ForEach(groups) { group in
+                        Section(header: Text(group.title)) {
+                            ForEach(group.items) { option in
+                                Text(displayName(option)).tag(option.id)
+                            }
+                        }
+                    }
+                }
+                .labelsHidden()
+                .frame(maxWidth: .infinity)
+                .disabled(!enabled || options.isEmpty)
+
+                Button("生成") {
+                    guard hasSelection else { return }
+                    onSpawn(selectedID)
+                }
+                .disabled(!enabled || !hasSelection)
+            }
+        }
+    }
+}
