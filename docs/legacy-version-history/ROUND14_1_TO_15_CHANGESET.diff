+    func openBackupFolder(_ backupID: String? = nil) {
+        var params: [String: Any] = [:]
+        if let backupID = backupID, !backupID.isEmpty { params["backupId"] = backupID }
+        send("open_backup_folder", params: params, title: backupID == nil ? "打开备份目录" : "在文件夹中显示")
+    }
+
+    func restoreBackup(_ backupID: String) {
+        guard backups.contains(where: { $0.id == backupID && $0.valid }) else {
+            error = "请选择校验通过的备份。"; return
+        }
+        send("restore_backup", params: ["backupId": backupID], title: "恢复所选存档")
+    }
+
+    func deleteBackup(_ backupID: String) {
+        guard backups.contains(where: { $0.id == backupID }) else { return }
+        send("delete_backup", params: ["backupId": backupID], title: "删除存档备份")
+    }
