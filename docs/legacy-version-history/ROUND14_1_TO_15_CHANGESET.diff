+import SwiftUI
+
+struct TrainerMetricCard<Content: View>: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    let tint: Color
+    let locked: Bool?
+    let lockEnabled: Bool
+    let onLock: (() -> Void)?
+    let content: Content
+
+    init(
+        title: String,
+        icon: String,
+        tint: Color,
+        locked: Bool? = nil,
+        lockEnabled: Bool = false,
+        onLock: (() -> Void)? = nil,
+        @ViewBuilder content: () -> Content
+    ) {
+        self.title = title
+        self.icon = icon
+        self.tint = tint
+        self.locked = locked
+        self.lockEnabled = lockEnabled
+        self.onLock = onLock
+        self.content = content()
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 10) {
+            HStack(spacing: 8) {
+                Label(title, systemImage: icon).font(.caption).foregroundStyle(tint.opacity(0.9))
+                Spacer()
+                if let locked, let onLock {
+                    TrainerLockButton(locked: locked, enabled: lockEnabled, action: onLock)
+                }
+            }
+            content.frame(maxWidth: .infinity, alignment: .center)
+        }
+        .frame(maxWidth: .infinity, minHeight: 82, alignment: .leading)
+        .padding(15)
+        .background(theme.panel, in: RoundedRectangle(cornerRadius: theme.cardCornerRadius))
+    }
+}
+
+struct TrainerStatEditorRow<Field: Hashable>: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    @Binding var text: String
+    let focus: FocusState<Field?>.Binding
+    let focusValue: Field
+    let suffix: String
+    let locked: Bool
+    let supported: Bool
+    let available: Bool
+    let editable: Bool
+    let onLock: () -> Void
+
+    var body: some View {
+        TrainerMetricCard(
+            title: title,
+            icon: icon,
+            tint: theme.accent,
+            locked: locked,
+            lockEnabled: editable && supported && available,
+            onLock: onLock
+        ) {
+            HStack(spacing: 5) {
+                TextField("—", text: $text)
+                    .textFieldStyle(.plain)
+                    .multilineTextAlignment(.center)
+                    .frame(width: 80)
+                    .font(.system(size: 20, weight: .semibold, design: .rounded))
+                    .monospacedDigit()
+                    .focused(focus, equals: focusValue)
+                    .disabled(!editable || !supported || !available)
+                if !suffix.isEmpty {
+                    Text(suffix).font(.caption).foregroundStyle(.secondary)
+                }
+            }
+        }
+        .opacity(supported ? (available ? 1 : 0.65) : 0.42)
+    }
+}
+
+struct TrainerInlineStatEditorRow<Field: Hashable>: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    @Binding var text: String
+    let focus: FocusState<Field?>.Binding
+    let focusValue: Field
+    let suffix: String
+    let locked: Bool
+    let supported: Bool
+    let available: Bool
+    let editable: Bool
+    let onLockChange: (Bool) -> Void
+
+    var body: some View {
+        HStack(spacing: 12) {
+            Text(title).font(.subheadline.weight(.semibold))
+            Spacer()
+            TextField("数值", text: $text)
+                .textFieldStyle(.roundedBorder)
+                .frame(width: 90)
+                .focused(focus, equals: focusValue)
+                .disabled(!editable || !supported || !available)
+            if !suffix.isEmpty {
+                Text(suffix).foregroundStyle(.secondary).frame(width: 18)
+            }
+            Toggle("锁定", isOn: Binding(get: { locked }, set: onLockChange))
+                .toggleStyle(.switch)
+                .controlSize(.small)
+                .labelsHidden()
+                .disabled(!editable || !supported || !available)
+        }
+        .opacity(supported ? (available ? 1 : 0.65) : 0.45)
+        .padding(.horizontal, 22)
+        .frame(minHeight: 62)
+        .background(theme.panel)
+    }
+}
