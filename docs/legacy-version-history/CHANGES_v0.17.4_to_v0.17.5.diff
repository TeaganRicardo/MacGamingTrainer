+import SwiftUI
+
+/// Pure presentation state for a feature control. Game modules translate their
+/// own runtime/desired-state semantics into this visual state; Core never knows
+/// why a feature is waiting, detached, unsupported, etc.
+struct TrainerFeatureControlState {
+    let isOn: Bool
+    let isInteractive: Bool
+    let canEditValue: Bool
+    let opacity: Double
+    let indicatorColor: Color
+    let toggleColor: Color
+    let helpText: String
+    let isWarning: Bool
+}
+
+struct TrainerFeatureToggleRow: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    let state: TrainerFeatureControlState
+    let shortcutText: String?
+    let action: () -> Void
+
+    var body: some View {
+        HStack(spacing: 16) {
+            Image(systemName: icon)
+                .font(.title3)
+                .foregroundStyle(state.indicatorColor)
+                .frame(width: 40, height: 40)
+                .background(state.indicatorColor.opacity(state.isOn ? 0.15 : 0.05), in: RoundedRectangle(cornerRadius: 10))
+            Text(title).font(.subheadline.weight(.semibold))
+            Spacer()
+            Group {
+                if let shortcutText {
+                    TrainerShortcutBadge(text: shortcutText)
+                } else {
+                    Color.clear.frame(width: 44, height: 25)
+                }
+            }
+            .frame(width: 52)
+            TrainerToggleControl(
+                isOn: state.isOn,
+                enabled: state.isInteractive,
+                tint: state.toggleColor,
+                helpText: state.helpText,
+                action: action
+            )
+            .accessibilityLabel(title)
+            .accessibilityValue(state.isOn ? "开启" : "关闭")
+        }
+        .opacity(state.opacity)
+        .frame(minHeight: 64)
+        .padding(.horizontal, 22)
+        .background(theme.panel)
+    }
+}
+
+struct TrainerFeatureMultiplierRow: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    let state: TrainerFeatureControlState
+    @Binding var text: String
+    let shortcutText: String?
+    let action: () -> Void
+
+    var body: some View {
+        HStack(spacing: 14) {
+            Image(systemName: icon)
+                .font(.title3)
+                .foregroundStyle(state.indicatorColor)
+                .frame(width: 40, height: 40)
+                .background(state.indicatorColor.opacity(state.isOn ? 0.15 : 0.05), in: RoundedRectangle(cornerRadius: 10))
+            Text(title).font(.subheadline.weight(.semibold))
+            Spacer()
+            TrainerNumberField(text: $text, placeholder: "2", width: 70, enabled: state.canEditValue, alignment: .leading)
+            Text("×").foregroundStyle(.secondary)
+            if let shortcutText {
+                Text(shortcutText)
+                    .font(.system(.caption, design: .monospaced))
+                    .foregroundStyle(.secondary)
+                    .frame(width: 40)
+            }
+            TrainerToggleControl(
+                isOn: state.isOn,
+                enabled: state.isInteractive,
+                tint: state.toggleColor,
+                helpText: state.helpText,
+                action: action
+            )
+        }
+        .opacity(state.opacity)
+        .frame(minHeight: 64)
+        .padding(.horizontal, 22)
+        .background(theme.panel)
+    }
+}
+
+/// Preserves the native compact switch used by the pre-decoupling resource
+/// multiplier rows. The main feature list intentionally uses the custom 44x25
+/// capsule switch instead.
+struct TrainerCompactMultiplierRow: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    let state: TrainerFeatureControlState
+    @Binding var text: String
+    let shortcutText: String?
+    let action: () -> Void
+
+    var body: some View {
+        HStack(spacing: 12) {
+            Label(title, systemImage: icon)
+                .font(.subheadline.weight(.medium))
+                .foregroundStyle(state.isWarning ? theme.warning : .primary)
+            Spacer()
+            TrainerNumberField(text: $text, placeholder: "2", width: 70, enabled: state.canEditValue, alignment: .leading)
+            Text("×").foregroundStyle(.secondary)
+            if let shortcutText {
+                Text(shortcutText)
+                    .font(.system(.caption, design: .monospaced))
+                    .foregroundStyle(.secondary)
+                    .frame(width: 40)
+            }
+            Toggle(title, isOn: Binding(get: { state.isOn }, set: { _ in action() }))
+                .labelsHidden()
+                .toggleStyle(.switch)
+                .controlSize(.small)
+                .tint(state.isWarning ? theme.warning : theme.accent)
+                .disabled(!state.isInteractive)
+        }
+        .opacity(state.opacity)
+    }
+}
