@@ -0,0 +1,48 @@
+import SwiftUI
+
+struct Hades2PickerSection<Item: Identifiable>: Identifiable {
+    let id: Int
+    let title: String
+    let items: [Item]
+}
+
+struct Hades2ResourceEditor<Item: Identifiable>: View where Item.ID == String {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    @Binding var search: String
+    @Binding var selection: String
+    @Binding var amount: String
+    let sections: [Hades2PickerSection<Item>]
+    let enabled: Bool
+    let locked: Bool
+    let itemLabel: (Item) -> String
+    let onLock: () -> Void
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 18) {
+            HStack {
+                Label(title, systemImage: icon).font(.subheadline.weight(.medium)).foregroundStyle(theme.accent)
+                Spacer()
+                TextField("搜索名称或资源 ID", text: $search).textFieldStyle(.roundedBorder).frame(maxWidth: 260)
+            }
+            Picker(title, selection: $selection) {
+                if selection.isEmpty || sections.allSatisfy({ $0.items.isEmpty }) { Text("没有匹配项目").tag("") }
+                ForEach(sections) { section in
+                    Section(header: Text(section.title)) {
+                        ForEach(section.items) { item in Text(itemLabel(item)).tag(item.id) }
+                    }
+                }
+            }
+            .labelsHidden()
+            .frame(maxWidth: .infinity)
+            .disabled(!enabled || sections.allSatisfy({ $0.items.isEmpty }))
+
+            HStack(spacing: 12) {
+                Spacer()
+                TrainerNumberField(text: $amount, placeholder: "数量", width: 100, enabled: enabled && !selection.isEmpty)
+                TrainerLockButton(locked: locked, enabled: enabled && !selection.isEmpty, action: onLock)
+            }
+        }
+    }
+}
