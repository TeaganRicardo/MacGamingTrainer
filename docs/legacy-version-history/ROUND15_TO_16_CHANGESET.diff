+from . import localization
+from .config import GAME_SPEC
+
+
+def localize_catalog(decoded):
+    entries=decoded.get('rewards')
+    if not isinstance(entries,list):entries=decoded.get('boons')
+    if not isinstance(entries,list):entries=[]
+    resources=decoded.get('resources') if isinstance(decoded.get('resources'),list) else []
+    lookup=[]
+    for item in entries:
+        if not isinstance(item,dict):continue
+        identifier=item.get('trait') if item.get('kind')=='trait' else item.get('id')
+        if isinstance(identifier,str) and identifier:lookup.append(identifier)
+    for item in resources:
+        if isinstance(item,dict) and isinstance(item.get('id'),str):lookup.append(item['id'])
+    if not lookup:return decoded
+    unique=set(lookup)
+    zh=localization.official_display_names(unique,'zh-CN')
+    en=localization.official_display_names(unique,'en')
+    missing_special=[]
+    for item in entries:
+        if not isinstance(item,dict):continue
+        identifier=item.get('trait') if item.get('kind')=='trait' else item.get('id')
+        if not isinstance(identifier,str):continue
+        official_zh=zh.get(identifier)
+        if official_zh is not None:
+            source=item.get('sourceName')
+            item['name']=official_zh if not isinstance(source,str) or not source else (official_zh if official_zh.startswith(source) else source+' · '+official_zh)
+            item['officialName']=True
+        else:
+            item['officialName']=False
+            if item.get('kind')=='trait':missing_special.append(identifier)
+            elif isinstance(item.get('sourceName'),str) and item.get('sourceName'):
+                base=item.get('name') if isinstance(item.get('name'),str) else identifier
+                prefix=item['sourceName']+' · '
+                item['name']=base if base.startswith(prefix) else prefix+base
+        if identifier in en:item['englishName']=en[identifier]
+    for item in resources:
+        if not isinstance(item,dict) or not isinstance(item.get('id'),str):continue
+        identifier=item['id']
+        if identifier in zh:item['name']=zh[identifier];item['officialName']=True
+        if identifier in en:item['englishName']=en[identifier]
+    if missing_special:
+        missing=set(missing_special)
+        entries[:] = [item for item in entries if not (isinstance(item,dict) and item.get('kind')=='trait' and item.get('trait') in missing)]
+        warnings=decoded.get('warnings') if isinstance(decoded.get('warnings'),list) else []
+        message=f'未从本机 {GAME_SPEC.display_name} 中文语言文件解析到 {len(missing)} 项特殊祝福的官方名称，已暂时隐藏。'
+        if message not in warnings:warnings.append(message)
+        decoded['warnings']=warnings
+    return decoded
