++class Hades2ProfileService:
++    """Profile file I/O only. Runtime replay remains in the adapter."""
++    def __init__(self, root):
++        self.root=root
++        self.root.mkdir(parents=True,exist_ok=True)
++
++    @staticmethod
++    def sanitize_name(name):
++        if not isinstance(name,str):raise ValueError('Profile 名称无效。')
++        name=name.strip()
++        if not name or len(name)>64 or any(ord(ch)<32 for ch in name):raise ValueError('Profile 名称必须为 1–64 个可见字符。')
++        if '/' in name or '\\' in name:raise ValueError('Profile 名称不能包含路径分隔符。')
++        return name
++
++    def path(self,name):
++        safe=self.sanitize_name(name)
++        slug=hashlib.sha256(safe.encode('utf-8')).hexdigest()[:24]
++        return self.root/(slug+'.json')
++
++    def list(self):
++        rows=[]
++        for path in sorted(self.root.glob('*.json')):
++            try:
++                data=json.loads(path.read_text(encoding='utf-8'))
++                name=data.get('name')
++                if not isinstance(name,str) or not name:continue
++                rows.append({'name':name,'updatedAt':data.get('updatedAt',''),'shortcuts':data.get('shortcuts',{})})
++            except Exception:logging.exception('Ignoring corrupt profile %s',path)
++        rows.sort(key=lambda item:item['name'].casefold())
++        return rows
++
++    def save(self,name,preferences,shortcuts=None):
++        name=self.sanitize_name(name)
++        payload={'name':name,'updatedAt':time.strftime('%Y-%m-%dT%H:%M:%S%z'),'desired':preferences}
++        if isinstance(shortcuts,dict):
++            payload['shortcuts']={str(key):int(value) for key,value in shortcuts.items() if type(value) is int and 0<=value<=9}
++        path=self.path(name);tmp=path.with_suffix('.tmp')
++        tmp.write_text(json.dumps(payload,ensure_ascii=False,sort_keys=True,indent=2)+'\n',encoding='utf-8');tmp.replace(path)
++        return {'saved':True,'name':name,'profiles':self.list()}
++
++    def load(self,name):
++        path=self.path(name)
++        if not path.is_file():raise ValueError('未找到该 Profile。')
++        payload=json.loads(path.read_text(encoding='utf-8'))
++        desired=payload.get('desired')
++        if not isinstance(desired,dict):raise ValueError('Profile 内容无效。')
++        return {'name':self.sanitize_name(name),'desired':desired,'shortcuts':payload.get('shortcuts',{})}
++
++    def delete(self,name):
++        path=self.path(name)
++        if not path.is_file():raise ValueError('未找到该 Profile。')
++        path.unlink()
++        return {'deleted':True,'name':self.sanitize_name(name),'profiles':self.list()}
