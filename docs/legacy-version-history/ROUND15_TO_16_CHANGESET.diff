+-def _load_official_display_names(language):
+-    language = str(language)
+-    cached = _OFFICIAL_TEXT_CACHE.get(language)
+-    if cached is not None:
+-        return cached
+-    names = {}
+-    if not GAME.exists():
+-        _OFFICIAL_TEXT_CACHE[language] = names
+-        return names
+-    # Current Hades II macOS builds keep localized SJSON inside the app bundle.
+-    # Accept both layouts used by Supergiant builds/mod dumps:
+-    #   TraitText.zh-CN.sjson
+-    #   zh-CN/TraitText.sjson
+-    # Prefer the known Text roots and fall back to a whole-bundle search only
+-    # when none exist, avoiding multiple expensive traversals of the game app.
+-    roots = [
+-        GAME / 'Contents/Resources/Content/Game/Text',
+-        GAME / 'Contents/Resources/Game/Text',
+-        GAME / 'Contents/Resources/Content/Text',
+-    ]
+-    roots = [root for root in roots if root.exists()] or [GAME]
+-    candidates = set()
+-    try:
+-        for root in roots:
+-            for path in root.rglob('*.sjson'):
+-                if path.name.endswith(f'.{language}.sjson') or language in path.parts:
+-                    candidates.add(path)
+-        files = sorted(candidates)
+-    except OSError:
+-        files = []
