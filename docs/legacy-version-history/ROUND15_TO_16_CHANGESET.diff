@@ -0,0 +1,59 @@
+import SwiftUI
+
+struct TrainerRow<Leading: View, Trailing: View>: View {
+    @Environment(\.trainerTheme) private var theme
+    let leading: Leading
+    let trailing: Trailing
+    let minimumHeight: CGFloat
+    let enabled: Bool
+
+    init(
+        minimumHeight: CGFloat = 62,
+        enabled: Bool = true,
+        @ViewBuilder leading: () -> Leading,
+        @ViewBuilder trailing: () -> Trailing
+    ) {
+        self.leading = leading()
+        self.trailing = trailing()
+        self.minimumHeight = minimumHeight
+        self.enabled = enabled
+    }
+
+    var body: some View {
+        HStack(spacing: 14) {
+            leading
+            Spacer(minLength: 12)
+            trailing
+        }
+        .frame(minHeight: minimumHeight)
+        .padding(.horizontal, 22)
+        .background(theme.panel)
+        .opacity(enabled ? 1 : 0.45)
+    }
+}
+
+struct TrainerIconLabel: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    let tint: Color?
+    let emphasized: Bool
+
+    init(title: String, icon: String, tint: Color? = nil, emphasized: Bool = false) {
+        self.title = title
+        self.icon = icon
+        self.tint = tint
+        self.emphasized = emphasized
+    }
+
+    var body: some View {
+        HStack(spacing: 14) {
+            Image(systemName: icon)
+                .font(.title3)
+                .foregroundStyle(tint ?? theme.accent)
+                .frame(width: 40, height: 40)
+                .background((tint ?? theme.accent).opacity(emphasized ? 0.15 : 0.06), in: RoundedRectangle(cornerRadius: theme.controlCornerRadius))
+            Text(title).font(.subheadline.weight(.semibold))
+        }
+    }
+}
diff -ruN '--exclude=__pycache__' '--exclude=*.pyc' '--exclude=dist' /mnt/data/MacGamingTrainer_v15_round15/Sources/Core/UI/Primitives/TrainerToggleControl.swift /mnt/data/mgt_r16_work/Sources/Core/UI/Primitives/TrainerToggleControl.swift
--- /mnt/data/MacGamingTrainer_v15_round15/Sources/Core/UI/Primitives/TrainerToggleControl.swift	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/mgt_r16_work/Sources/Core/UI/Primitives/TrainerToggleControl.swift	2026-09-17 11:13:56.550829869 +0000
@@ -0,0 +1,51 @@
+import SwiftUI
+
+struct TrainerToggleControl: View {
+    @Environment(\.trainerTheme) private var theme
+    let isOn: Bool
+    let enabled: Bool
+    let tint: Color?
+    let helpText: String
+    let action: () -> Void
+
+    init(isOn: Bool, enabled: Bool = true, tint: Color? = nil, helpText: String = "", action: @escaping () -> Void) {
+        self.isOn = isOn
+        self.enabled = enabled
+        self.tint = tint
+        self.helpText = helpText
+        self.action = action
+    }
+
+    var body: some View {
+        Button(action: action) {
+            Capsule()
+                .fill(isOn ? (tint ?? theme.accent) : theme.mutedFill)
+                .frame(width: 44, height: 25)
+                .overlay(alignment: isOn ? .trailing : .leading) {
+                    Circle().fill(.white).frame(width: 19, height: 19).padding(3)
+                }
+        }
+        .buttonStyle(.plain)
+        .disabled(!enabled)
+        .help(helpText)
+    }
+}
+
+struct TrainerLockButton: View {
+    @Environment(\.trainerTheme) private var theme
+    let locked: Bool
+    let enabled: Bool
+    let action: () -> Void
+
+    var body: some View {
+        Button(action: action) {
+            Image(systemName: locked ? "lock.fill" : "lock.open")
+                .font(.caption.weight(.semibold))
+                .foregroundStyle(locked ? theme.accent : .secondary)
+                .frame(width: 26, height: 24)
+                .background((locked ? theme.mutedFill.opacity(0.62) : theme.subtleFill.opacity(0.875)), in: RoundedRectangle(cornerRadius: theme.compactCornerRadius))
+        }
+        .buttonStyle(.plain)
+        .disabled(!enabled)
+    }
+}
