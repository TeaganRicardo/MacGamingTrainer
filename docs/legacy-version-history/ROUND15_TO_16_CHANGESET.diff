+import SwiftUI
+
+struct Hades2StatEditorCard<Field: Hashable>: View {
+    @Environment(\.trainerTheme) private var theme
+    let title: String
+    let icon: String
+    @Binding var text: String
+    let focus: FocusState<Field?>.Binding
+    let focusValue: Field
+    let suffix: String
+    let locked: Bool
+    let supported: Bool
+    let available: Bool
+    let editable: Bool
+    let onLock: () -> Void
+
+    var body: some View {
+        TrainerMetricCard(title: title, icon: icon, tint: theme.accent) {
+            TrainerLockButton(locked: locked, enabled: editable && supported && available, action: onLock)
+        } content: {
+            HStack(spacing: 5) {
+                TextField("—", text: $text)
+                    .textFieldStyle(.plain)
+                    .multilineTextAlignment(.center)
+                    .frame(width: 80)
+                    .font(.system(size: 20, weight: .semibold, design: .rounded))
+                    .monospacedDigit()
+                    .focused(focus, equals: focusValue)
+                    .disabled(!editable || !supported || !available)
+                if !suffix.isEmpty { Text(suffix).font(.caption).foregroundStyle(.secondary) }
+            }
+        }
+        .opacity(supported ? (available ? 1 : 0.65) : 0.42)
+    }
+}
+
+struct Hades2InlineStatEditor<Field: Hashable>: View {
+    let title: String
+    @Binding var text: String
+    let focus: FocusState<Field?>.Binding
+    let focusValue: Field
+    let suffix: String
+    let locked: Bool
+    let supported: Bool
+    let available: Bool
+    let editable: Bool
+    let onLockChange: (Bool) -> Void
+
+    var body: some View {
+        TrainerRow(enabled: supported) {
+            Text(title).font(.subheadline.weight(.semibold))
+        } trailing: {
+            HStack(spacing: 12) {
+                TrainerNumberField(text: $text, enabled: editable && supported && available)
+                    .focused(focus, equals: focusValue)
+                if !suffix.isEmpty { Text(suffix).foregroundStyle(.secondary).frame(width: 18) }
+                Toggle("锁定", isOn: Binding(get: { locked }, set: onLockChange))
+                    .toggleStyle(.switch)
+                    .controlSize(.small)
+                    .labelsHidden()
+                    .disabled(!editable || !supported || !available)
+            }
+        }
+        .opacity(supported ? (available ? 1 : 0.65) : 0.45)
+    }
+}
