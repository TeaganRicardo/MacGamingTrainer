++import json
++import logging
++import math
++
++from .schema import MULTIPLIERS, TOGGLES
++
++
++class Hades2PreferenceStore:
++    def __init__(self, path):
++        self.path = path
++
++    @staticmethod
++    def defaults():
++        values={key:False for key in TOGGLES}
++        values.update(damageMultiplier=2.0,moneyMultiplier=2.0,resourceMultiplier=2.0,gameSpeed=1.0)
++        values.update(
++            boonRarity={'target':'Epic','multiplier':100.0,'allowLegendary':True,'allowDuo':True}, boonChoiceCount=3,
++            statLocks={},vitalLocks={},resourceLocks={},rerollsLock=None,elementLocks={},nextRoomReward=None,
++        )
++        return values
++
++    @classmethod
++    def normalize(cls, raw):
++        result=cls.defaults()
++        if not isinstance(raw,dict):return result
++        for key in TOGGLES:
++            if type(raw.get(key)) is bool:result[key]=raw[key]
++        for key in MULTIPLIERS:
++            value=raw.get(key)
++            if type(value) in (int,float) and not isinstance(value,bool) and math.isfinite(value):
++                if (key=='gameSpeed' and 0.1<=value<=5) or (key!='gameSpeed' and 1<=value<=100):result[key]=float(value)
++        rarity=raw.get('boonRarity')
++        if isinstance(rarity,dict):
++            target=rarity.get('target');mult=rarity.get('multiplier')
++            if target in ('Common','Rare','Epic','Heroic'):result['boonRarity']['target']=target
++            if type(mult) in (int,float) and not isinstance(mult,bool) and math.isfinite(mult) and 0<=mult<=1000:result['boonRarity']['multiplier']=float(mult)
++            if type(rarity.get('allowLegendary')) is bool:result['boonRarity']['allowLegendary']=rarity['allowLegendary']
++            if type(rarity.get('allowDuo')) is bool:result['boonRarity']['allowDuo']=rarity['allowDuo']
++        choice=raw.get('boonChoiceCount')
++        if type(choice) is int and not isinstance(choice,bool) and 1<=choice<=3:result['boonChoiceCount']=choice
++        for key in ('statLocks','vitalLocks','resourceLocks','elementLocks'):
++            if isinstance(raw.get(key),dict):result[key]=raw[key]
++        value=raw.get('rerollsLock')
++        if type(value) in (int,float) and not isinstance(value,bool) and math.isfinite(value) and value>=0:result['rerollsLock']=value
++        reward=raw.get('nextRoomReward')
++        if reward is None or isinstance(reward,str):result['nextRoomReward']=reward
++        return result
++
++    def load(self):
++        try:
++            if not self.path.is_file():return self.defaults(),False
++            raw=json.loads(self.path.read_text(encoding='utf-8'))
++            if not isinstance(raw,dict):return self.defaults(),False
++            return self.normalize(raw),True
++        except Exception:
++            logging.exception('Ignoring invalid desired-state profile')
++            return self.defaults(),False
++
++    def save(self, preferences):
++        try:
++            self.path.parent.mkdir(parents=True,exist_ok=True)
++            staged=self.path.with_suffix('.tmp')
++            staged.write_text(json.dumps(preferences,ensure_ascii=False,sort_keys=True,indent=2)+'\n',encoding='utf-8')
++            staged.replace(self.path)
++        except Exception:
++            logging.exception('Failed to persist desired-state profile')
