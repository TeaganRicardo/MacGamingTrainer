{
  "schemaVersion": 1,
  "id": "hades2",
  "displayName": "Hades II",
  "protocolVersion": 12,
  "backend": {
    "adapter": "games.hades2.adapter:Hades2Adapter"
  },
  "frontend": {
    "sourceDirectory": "Sources/Hades2",
    "moduleType": "Hades2GameModule",
    "architectures": [
      "arm64"
    ],
    "minimumMacOS": "14.0"
  },
  "steamAppId": "1145350",
  "buildRequirements": {
    "lldbPython": true,
    "debuggerEntitlement": true,
    "entitlements": "Backend/games/hades2/trainer-entitlements.plist"
  },
  "residentRuntime": {
    "source": "runtime/hades.lua",
    "previousRevisionPattern": "previousModule\\.revision\\s*~=\\s*(\\d+)",
    "moduleRevisionPattern": "version\\s*=\\s*1\\s*,\\s*revision\\s*=\\s*(\\d+)"
  },
  "app": {
    "bundleIdentifier": "com.gao.macgamingtrainer",
    "displayName": "Mac Gaming Trainer"
  },
  "appResources": [
    {
      "source": "docs/reference/hades2/1.139672-24556151/ui_terminology.json",
      "destination": "ui_terminology.json"
    },
    {
      "source": "Sources/Hades2/Presentation/Localization/hades2.zh-CN.json",
      "destination": "hades2.zh-CN.json"
    },
    {
      "source": "Sources/Hades2/Presentation/Localization/hades2.en.json",
      "destination": "hades2.en.json"
    }
  ],
  "targetApplication": {
    "processName": "Hades II",
    "bundleIdentifier": "com.supergiantgames.macos.hades2"
  },
  "saveManagement": {
    "roots": [
      {
        "id": "main",
        "path": "~/Library/Application Support/Supergiant Games/Hades II",
        "include": [
          "Profile*.sav",
          "activeProfile",
          "saveinfo"
        ]
      }
    ],
    "provider": "games.hades2.save_provider:Hades2SaveProvider",
    "hotBackup": true,
    "restorePolicy": "hotPreferred",
    "stagedRestore": true
  }
}
