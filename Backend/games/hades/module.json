{
  "schemaVersion": 1,
  "id": "hades",
  "displayName": "Hades",
  "protocolVersion": 9,
  "backend": {
    "adapter": "games.hades.adapter:HadesAdapter"
  },
  "commandContract": {
    "metadata": "games.hades.command_contract:command_metadata",
    "enumName": "HadesCommand",
    "defaultTimeoutSeconds": 30.0
  },
  "frontend": {
    "sourceDirectory": "Sources/Hades",
    "moduleType": "HadesGameModule",
    "minimumMacOS": "14.0"
  },
  "steamAppId": "1145360",
  "buildRequirements": {
    "lldbPython": true,
    "debuggerEntitlement": true,
    "entitlements": "Backend/games/hades/trainer-entitlements.plist"
  },
  "targetApplication": {
    "processName": "Game.macOS",
    "bundleIdentifier": "",
    "executablePathSuffix": "Hades/Game.macOS.app/Contents/MacOS/Game.macOS"
  },
  "saveManagement": {
    "roots": [
      {
        "id": "main",
        "path": "~/Library/Application Support/Supergiant Games/Hades",
        "include": [
          "Profile*.sav",
          "Profile*.sjson",
          "Profile*.ctrls",
          "activeProfile"
        ]
      }
    ],
    "provider": "games.hades.save_provider:HadesSaveProvider",
    "hotBackup": true,
    "restorePolicy": "stoppedOnly",
    "stagedRestore": true
  },
  "supportedBuild": {
    "architecture": "x86_64",
    "contentBuildInfo": "38284",
    "steamBuildID": "10929685",
    "uuid": "BA8CE510-EB7F-3E65-96B6-574608EA4550",
    "originalExecutableSHA256": "f69aab08ba6d12da66252a198d3c6c6606fc9de2e1b277458fae442526a75279",
    "referenceDirectory": "docs/reference/hades",
    "nativeUUIDHeader": "native/SupportedBuildIdentity.h"
  },
  "nativeLibraries": [
    {
      "source": "native/CommandMailbox.c",
      "filename": "libMGTHadesCommandMailbox.dylib",
      "architectures": [
        "arm64",
        "x86_64"
      ]
    }
  ],
  "appResources": [
    {
      "source": "Sources/Hades/Presentation/Localization/hades.zh-CN.json",
      "destination": "hades.zh-CN.json"
    },
    {
      "source": "Sources/Hades/Presentation/Localization/hades.en.json",
      "destination": "hades.en.json"
    }
  ]
}
